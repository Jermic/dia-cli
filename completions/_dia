#compdef dia

_dia_profiles() {
  local window index profile output
  local -a names
  local -A seen
  output=$(command dia profiles 2>/dev/null) || return
  while IFS=$'\t' read -r window index profile; do
    [[ $window == WINDOW || -z $profile || -n ${seen[$profile]-} ]] && continue
    seen[$profile]=1
    names+=("$profile")
  done <<< "$output"
  (( ${#names} )) && compadd -- "${names[@]}"
}

emulate -L zsh
local cmd=${words[2]} arity=0 pending='' i literalAt=99999 explicitKeyword=0
local -a subcommands flags
subcommands=(dedupe dd domains ds tabs t find f current c count n links l open o help h version v -v --version focus fo close cl move m move-domain mv md navigate nav exec e windows w profiles ps profile p layout la)
if (( CURRENT == 2 )); then
  compadd -- "${subcommands[@]}" --help -h
  return
fi
case $cmd in
  dd) cmd=dedupe ;; ds) cmd=domains ;; t) cmd=tabs ;; f) cmd=find ;; c) cmd=current ;; n) cmd=count ;; l) cmd=links ;;
  o) cmd=open ;; h) cmd=help ;; fo) cmd=focus ;; cl) cmd=close ;;
  m) cmd=move ;; mv|md) cmd=move-domain ;; nav) cmd=navigate ;;
  e) cmd=exec ;; w) cmd=windows ;; ps) cmd=profiles ;; p) cmd=profile ;; la) cmd=layout ;;
  v|-v|--version) cmd=version ;;
esac
case $cmd in
  help)
    (( CURRENT == 3 )) && compadd -- "${subcommands[@]}" --help -h
    return ;;
  find|focus|profile|layout|open|close) arity=1 ;;
  move|move-domain|navigate|exec) arity=2 ;;
  dedupe|domains|tabs|current|count|links|version|windows|profiles) ;;
  *) return ;;
esac
if [[ $cmd == move-domain && ( ${words[3]} == -k || ${words[3]} == --keyword ) ]]; then
  (( CURRENT == 3 )) && return
  explicitKeyword=1
  words[3]=()
  (( CURRENT-- ))
  (( CURRENT == 3 )) && return
fi
if [[ $cmd == move-domain && ${words[3]} != -- ]] && (( ! explicitKeyword )); then
  case ${words[4]} in
    -p|--profile|-w|--window|-D|--domain|-k|--keyword|--pinned|--unpinned|-up|--exclude-domain|-exd|--loading|-n|--dry-run|-E|--exact-domain) arity=1 ;;
  esac
fi
for (( i = 3; i < CURRENT; i++ )); do
  if [[ ${words[i]} == -- ]] && ! (( explicitKeyword && i == 3 )); then
    literalAt=$i
    words[$i]=()
    (( CURRENT-- ))
    break
  fi
  if (( i >= 3 + arity )); then
    case ${words[i]} in
      -p|--profile|-w|--window|-D|--domain|-k|--keyword|-exd|--exclude-domain) (( i++ )) ;;
    esac
  fi
done
if (( CURRENT <= 2 + arity )); then
  if [[ ${words[CURRENT]} == -* ]] && (( CURRENT < literalAt )); then
    compadd -- -h --help
    return
  fi
  case $cmd:$CURRENT in
    profile:3|move:4|move-domain:3|move-domain:4) _dia_profiles ;;
    layout:3) compadd -- sidebar tabStrip ;;
  esac
  return
fi
if [[ $cmd == move-domain ]] && (( arity == 2 && literalAt > 4 )); then
  case ${words[4]} in
    -p|--profile|-w|--window|-D|--domain|-k|--keyword|--pinned|--unpinned|-up|--exclude-domain|-exd|--loading|-n|--dry-run|-E|--exact-domain) return ;;
  esac
fi
for (( i = 3 + arity; i < CURRENT; i++ )); do
  if [[ -n $pending ]]; then
    pending=''
    continue
  fi
  case ${words[i]} in
    -p|--profile|-w|--window|-D|--domain|-k|--keyword|-exd|--exclude-domain) pending=${words[i]} ;;
    -h|--help) return ;;
  esac
done
case $pending in
  -p|--profile)
    case $cmd in dedupe|domains|tabs|find|count|links|move-domain|profiles) _dia_profiles ;; esac
    return ;;
  -w|--window|-D|--domain|-k|--keyword|-exd|--exclude-domain) return ;;
esac
(( CURRENT >= literalAt )) && return
flags=(-h --help)
case $cmd in
  tabs) flags+=(-w --window -p --profile -D --domain -k --keyword -E --exact-domain --pinned --loading -up --unpinned -exd --exclude-domain -d -detail -s -st -sl) ;;
  dedupe|domains|find|count|links|move-domain)
    flags+=(-w --window -p --profile -D --domain -k --keyword -E --exact-domain --pinned --loading -up --unpinned -exd --exclude-domain)
    [[ $cmd == move-domain || $cmd == dedupe ]] && flags+=(-n --dry-run)
    [[ $cmd == dedupe ]] && flags+=(-a --apply)
    [[ $cmd == domains ]] && flags+=(-s --subdomains) ;;
  profiles) flags+=(-w --window -p --profile -D --domain -k --keyword -E --exact-domain -exd --exclude-domain -c --counts) ;;
  current|windows|focus|profile|layout) flags+=(-w --window) ;;
esac
compadd -- "${flags[@]}"

